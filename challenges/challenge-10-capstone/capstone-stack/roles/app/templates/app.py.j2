#!/usr/bin/env python3
# {{ ansible_managed }}
"""The capstone app: a small HTTP service that uses only the Python standard library."""
import configparser
import json
import socket
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = "{{ app_conf_path }}"
LEVELS = ("debug", "info", "warning", "error")

cfg = configparser.ConfigParser(interpolation=None)
if not cfg.read(CONF):
    sys.exit("capstone-app: cannot read " + CONF)
PORT = cfg.getint("app", "port")
LEVEL = cfg.get("app", "log_level")
RELEASE = cfg.get("app", "release")
DB_HOST = cfg.get("db", "host")
DB_PORT = cfg.getint("db", "port")
DB_PASSWORD = cfg.get("db", "password")
if LEVEL not in LEVELS:
    sys.exit("capstone-app: unknown log_level '%s', use one of: %s" % (LEVEL, ", ".join(LEVELS)))


def database_answers():
    """Log in to redis and send PING. True only if the password is right and redis answers."""
    try:
        with socket.create_connection((DB_HOST, DB_PORT), timeout=2) as s:
            pw = DB_PASSWORD.encode()
            s.sendall(b"*2\r\n$4\r\nAUTH\r\n$%d\r\n%s\r\n" % (len(pw), pw))
            if not s.recv(64).startswith(b"+OK"):
                return False
            s.sendall(b"*1\r\n$4\r\nPING\r\n")
            return s.recv(64).startswith(b"+PONG")
    except OSError:
        return False


class Handler(BaseHTTPRequestHandler):
    server_version = "capstone-app"

    def log_message(self, fmt, *args):
        if LEVEL in ("debug", "info"):
            sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))
            sys.stderr.flush()

    def send(self, code, body, kind="application/json"):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":
            db = database_answers()
            body = {"status": "ok" if db else "degraded", "release": RELEASE, "host": socket.gethostname(), "db": "ok" if db else "down"}
            self.send(200 if db else 503, json.dumps(body))
        elif self.path == "/":
            self.send(200, "capstone app, release %s\n" % RELEASE, "text/plain")
        else:
            self.send(404, json.dumps({"error": "not found"}))


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
